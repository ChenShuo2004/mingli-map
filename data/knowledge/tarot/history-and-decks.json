{
  "schema_version": "1.0.0",
  "id": "tarot-history-decks",
  "title": "塔罗历史与牌系",
  "summary": "从15世纪纸牌游戏到RWS牌系，快速看懂塔罗的历史变化与常见牌系差别。",
  "timeline": [
    {
      "id": "early-italy",
      "period": "1440s–1450s",
      "place": "意大利北部",
      "title": "最早记录中的塔罗是纸牌游戏",
      "note": "56张四花色牌，加上21张王牌与愚人牌。早期牌组的顺序和张数并不完全统一。",
      "mark": "TRIONFI",
      "artifact_image": "https://upload.wikimedia.org/wikipedia/commons/b/bd/Visconti-Sforza_tarot_deck._Death.jpg",
      "artifact_label": "Visconti–Sforza · 15世纪",
      "artifact_alt": "Visconti–Sforza牌组死神牌"
    },
    {
      "id": "marseille-print",
      "period": "17–18世纪",
      "place": "法国印刷传统",
      "title": "木刻与模板上色让牌面广泛流通",
      "note": "今天常说的马赛系保留意大利式四花色；法国馆藏可见1701至1715年的78张Jean Dodal牌组。",
      "mark": "MARSEILLE",
      "artifact_image": "https://upload.wikimedia.org/wikipedia/commons/e/e0/Jean_Dodal_Tarot_trump_01.jpg",
      "artifact_label": "Jean Dodal · 1701–1715",
      "artifact_alt": "Jean Dodal马赛塔罗魔术师牌"
    },
    {
      "id": "occult-turn",
      "period": "18世纪末–19世纪",
      "place": "法国与英国",
      "title": "占卜与神秘主义解释逐渐进入塔罗",
      "note": "塔罗与占卜、神秘主义的广泛关联形成得较晚，不能倒推成15世纪牌组原本的用途。",
      "mark": "DIVINATION",
      "artifact_image": "https://upload.wikimedia.org/wikipedia/commons/f/fa/Court_de_G%C3%A9belin_-_Atout_00.jpg",
      "artifact_label": "Court de Gébelin · 1781",
      "artifact_alt": "Court de Gébelin 1781年塔罗愚人图版"
    },
    {
      "id": "rws",
      "period": "1909–1910",
      "place": "伦敦",
      "title": "Pamela Colman Smith画出RWS牌面",
      "note": "Waite策划、Smith绘制、Rider出版。56张小阿卡纳也采用完整场景插图，成为后来大量现代牌组的视觉参照。",
      "mark": "RWS"
    }
  ],
  "deck_families": [
    {
      "id": "visconti",
      "name": "早期意大利牌",
      "latin": "Visconti–Sforza",
      "period": "约1450",
      "look": "手绘金底，人物服饰接近当时宫廷",
      "difference": "留存牌常不完整；早期王牌没有统一印刷编号",
      "sample_image": "https://upload.wikimedia.org/wikipedia/commons/b/bd/Visconti-Sforza_tarot_deck._Death.jpg",
      "sample_alt": "Visconti–Sforza牌组死神牌"
    },
    {
      "id": "marseille",
      "name": "马赛系",
      "latin": "Tarot de Marseille",
      "period": "17–18世纪形成印刷传统",
      "look": "木刻线条、模板上色、法文牌名",
      "difference": "数字牌多以花色符号排列，不采用RWS式完整场景",
      "sample_image": "https://upload.wikimedia.org/wikipedia/commons/e/e0/Jean_Dodal_Tarot_trump_01.jpg",
      "sample_alt": "Jean Dodal马赛塔罗魔术师牌"
    },
    {
      "id": "rws",
      "name": "RWS牌系",
      "latin": "Rider–Waite–Smith",
      "period": "1909–1910",
      "look": "大、小阿卡纳都有完整叙事画面",
      "difference": "本专题以这一牌系的78张牌面与Waite牌义作为固定对照",
      "sample_image": "/tarot/rws/TheMagician.png",
      "sample_alt": "RWS魔术师牌"
    }
  ],
