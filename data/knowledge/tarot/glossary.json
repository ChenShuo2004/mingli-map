    },
    {
      "id":"reversed","group":"orientation","term":"逆位","latin":"Reversed","short":"牌面上下倒转",
      "detail":"同一张牌旋转180度后的方向状态。不同作者是否采用逆位并不完全一致。",
      "example":"查看Waite 1910逆位短义",
      "route":"/topic/tarot/major-arcana-images?card=0&mode=reversed",
      "related":["upright","card-meaning"]
    },
    {
      "id":"spread","group":"spread","term":"牌阵","latin":"Spread","short":"一组牌位的排列方式",
      "detail":"牌阵规定放几张牌、按什么顺序摆放，以及每个位置叫什么。",
      "example":"单张 · 三张 · 五张 · 凯尔特十字",
      "route":"/topic/tarot/spread-structures",
      "related":["position"]
    },
    {
      "id":"position","group":"spread","term":"牌位","latin":"Position","short":"牌阵中的一个位置",
      "detail":"牌位先给出问题角度，再由放入该位置的具体牌提供单牌内容。",
