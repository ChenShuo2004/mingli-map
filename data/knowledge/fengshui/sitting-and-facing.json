{
  "id": "sitting-and-facing",
  "title": "坐山与向首",
  "summary": "坐与向是一条穿过观察中心的相反轴线：坐山记录背后方向，向首记录面对方向；两者相差180°，共同组成一条完整坐向。",
  "axis_fields": [
    {"label":"观察中心","meaning":"坐向轴线穿过的立极点"},
    {"label":"坐山","meaning":"由中心指向背后的一端"},
    {"label":"向首","meaning":"由中心指向面对的一端"},
    {"label":"轴线","meaning":"坐山与向首相差180°的同一直线"}
  ],
  "opposite_pairs": [["子","午"],["癸","丁"],["丑","未"],["艮","坤"],["寅","申"],["甲","庚"],["卯","酉"],["乙","辛"],["辰","戌"],["巽","乾"],["巳","亥"],["丙","壬"]],
  "examples": [
    {"sitting":"子","facing":"午","sitting_degree":0,"facing_degree":180,"name":"坐子向午"},
    {"sitting":"卯","facing":"酉","sitting_degree":90,"facing_degree":270,"name":"坐卯向酉"},
    {"sitting":"巽","facing":"乾","sitting_degree":135,"facing_degree":315,"name":"坐巽向乾"}
  ],
  "boundaries": ["朝向必须连同坐山一起记录，单写一个山位容易丢失轴线方向","建筑正门、采光面、道路方向和罗盘向首不必天然等同，应先说明采用哪条轴线","坐向命名只说明方位，不直接推出八宅或玄空结论"],
