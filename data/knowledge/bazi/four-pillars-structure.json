    {"id": "month", "label": "月柱", "records": "出生月令", "stem_source": "由年干起月", "branch_source": "按月令排列"},
    {"id": "day", "label": "日柱", "records": "出生日", "stem_source": "干支纪日", "branch_source": "干支纪日"},
    {"id": "hour", "label": "时柱", "records": "出生时辰", "stem_source": "由日干起时", "branch_source": "十二时辰"}
