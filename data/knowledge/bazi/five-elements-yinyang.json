    {"name": "火", "yang_stem": "丙", "yin_stem": "丁", "description": "《洪范》以“炎上”说其性。"},
    {"name": "土", "yang_stem": "戊", "yin_stem": "己", "description": "《洪范》以“稼穑”说其性。"},
    {"name": "金", "yang_stem": "庚", "yin_stem": "辛", "description": "《洪范》以“从革”说其性。"},
    {"name": "水", "yang_stem": "壬", "yin_stem": "癸", "description": "《洪范》以“润下”说其性。"}
  ],
  "generating_cycle": ["木生火", "火生土", "土生金", "金生水", "水生木"],
  "overcoming_cycle": ["木克土", "土克水", "水克火", "火克金", "金克木"],
  "yin_yang_note": "阴阳在这里是同一五行内的分类属性，不是吉凶标签。十神先看五行生克方向，再以阴阳同异区分。",
