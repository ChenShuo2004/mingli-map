  "title": "同一组三数在六位与九位系统中的路径差异",
  "summary": "六位与九位系统即使接收同样的五月、二十三、戌时序数十一，也不会得到完全相同的三步路径。两者都从大安起、都把前一步落点作为下一次数数的起点，但循环长度和位序表不同：六位路径为小吉、速喜、大安，九位路径为小吉、天德、大安。这个节点只比较计算路径，不继承原资料对案例结果的判断。",
  "source_scope": {
    "source": "Horace-Maxwell/divination-notes-prompt 小六壬笔记",
    "commit": "b22ecfaafcd17782ddc0f633df163b6492b766d4",
    "status": "无仓库许可的并列版本笔记；只保存短字段与原创结构摘要"
  },
  "fixed_input": {
    "lunar_month": 5,
    "lunar_day": 23,
    "hour_branch": "戌",
    "hour_index": 11,
    "start_name": "大安",
    "counting_rule": "起点自身计1；后一个数字从上一步落点重新计1"
  },
  "systems": [
    {
      "id": "six_position",
      "label": "六位系统",
      "cycle_length": 6,
      "sequence": ["大安", "留连", "速喜", "赤口", "小吉", "空亡"],
      "steps": [
        {"stage": "月", "input": 5, "start": "大安", "result_position": 5, "result": "小吉"},
        {"stage": "日", "input": 23, "start": "小吉", "result_position": 3, "result": "速喜"},
        {"stage": "时", "input": 11, "start": "速喜", "result_position": 1, "result": "大安"}
      ]
    },
    {
      "id": "nine_position",
      "label": "九位系统",
      "cycle_length": 9,
      "sequence": ["大安", "留连", "速喜", "赤口", "小吉", "空亡", "病符", "桃花", "天德"],
      "steps": [
        {"stage": "月", "input": 5, "start": "大安", "result_position": 5, "result": "小吉"},
        {"stage": "日", "input": 23, "start": "小吉", "result_position": 9, "result": "天德"},
        {"stage": "时", "input": 11, "start": "天德", "result_position": 1, "result": "大安"}
