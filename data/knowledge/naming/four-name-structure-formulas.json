    {"symbol": "G2", "label": "名二", "content": "第二名字的笔画"}
  ],
  "formulas": [
    {"id": "single-single", "type": "单姓单名", "layout": "S1｜G1", "heaven": "S1＋1", "person": "S1＋G1", "earth": "G1＋1", "outer": "2", "total": "S1＋G1", "outer_equivalent": "两个补一单位"},
    {"id": "single-double", "type": "单姓双名", "layout": "S1｜G1＋G2", "heaven": "S1＋1", "person": "S1＋G1", "earth": "G1＋G2", "outer": "总格－人格＋1", "total": "S1＋G1＋G2", "outer_equivalent": "G2＋1"},
