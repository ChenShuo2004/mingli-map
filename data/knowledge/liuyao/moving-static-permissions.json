    {"id":"strong_still_to_weak_moving","label":"旺静 → 衰动","attacker":{"motion":"静","strength":"旺相"},"target":{"motion":"动","strength":"休囚"},"relation":"生／克／刑冲","allowed":false,"rule":"静爻伤不得动爻","note":"静爻虽旺，不据此反压已经发动的爻。"}
